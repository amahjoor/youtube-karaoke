# Environment Variables for Karaoke Platform

# Genius API Token (optional but recommended)
# Get your token from: https://genius.com/api-clients
# Without this, lyrics alignment will use Whisper-only mode
GENIUS_ACCESS_TOKEN=

# Note: You can run the app without this token, but you'll get better
# lyrics accuracy with it. The app will fall back to Whisper-only mode
# if no token is provided.
